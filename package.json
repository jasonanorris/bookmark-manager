{
  "name": "bookmark-manager",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "npm run build:web && npm run build:extension",
    "build:web": "vite build",
    "build:extension": "tsc -p extension/tsconfig.json",
    "package:extension": "npm run build:extension && mkdir -p extension/releases && cd extension && zip -r releases/bookmark-manager-0.1.1.zip manifest.json popup.html popup.css options.html options.css dist",
    "typecheck": "tsc --noEmit && tsc -p extension/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250725.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.3",
    "vite": "^5.4.14",
    "vitest": "^2.1.8",
    "wrangler": "^3.109.2"
  }
}
