{
  "name": "bookmark-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "npm run build:web && npm run build:extension",
    "build:web": "vite build",
    "build:extension": "tsc -p extension/tsconfig.json",
    "package:extension": "npm run build:extension && mkdir -p extension/releases && cd extension && zip -r releases/bookmark-manager-1.0.0.zip manifest.json popup.html popup.css options.html options.css dist",
    "typecheck": "tsc --noEmit && tsc -p extension/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "allowScripts": {
    "workerd@1.20260722.1": true,
    "esbuild@0.28.1": true
  }
}
