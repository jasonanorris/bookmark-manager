{
  "manifest_version": 3,
  "name": "Bookmark Manager",
  "version": "0.1.0",
  "description": "Save the current tab to your self-hosted bookmark manager.",
  "permissions": ["activeTab", "storage", "tabs"],
  "action": {
    "default_title": "Save Bookmark",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-manager@radarapp.us",
      "strict_min_version": "109.0"
    }
  }
}

